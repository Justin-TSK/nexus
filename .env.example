# ── Clés API (obligatoires) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAExempleDeToken
GEMINI_API_KEY=cle_gemini

# ── DeepL (optionnel, pour /traduire) ──────────────────────────────
DEEPL_API_KEY=

# ── Sécurité ────────────────────────────────────────────────────────
# IDs Telegram autorisés (séparés par des virgules).
# Vide = tout le monde peut utiliser le bot. Recommandé pour un bot perso.
ALLOWED_USER_IDS=

# ── Personnalisation ────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
TRANSCRIPTION_LANG=fr
# Profil de l'utilisateur : injecté dans le prompt pour que le bot le connaisse
# (s'adresser à lui par son prénom, répondre à « qui suis-je ? »).
USER_PROFILE=Prénom : Justin. Étudiant en informatique à Moscou.

# ── Mode de démarrage ───────────────────────────────────────────────
# polling (défaut) ou webhook (VPS + domaine/HTTPS)
BOT_MODE=polling
# WEBHOOK_URL=https://bot.exemple.com
# WEBHOOK_PORT=8443

# ── Notion ──────────────────────────────────────────────────────────
# Token d'intégration Notion (notion.so/my-integrations)
NOTION_TOKEN=
# ID de la base de notes (ex: 1a2b3c... — l'ID dans l'URL de la page)
NOTION_DATABASE_ID=
# Nom de la propriété titre de ta base (défaut "Name")
NOTION_TITLE_PROPERTY=Name
# OU : ID d'une page Notion où créer les notes comme sous-pages
# (alternative à la base de données, pratique si tu as des pages privées)
NOTION_PARENT_PAGE_ID=

# ── Gmail (OAuth Google) ────────────────────────────────────────────
# Fichier client_secret.json téléchargé depuis Google Cloud Console
# (projet avec l'API Gmail activée). Puis : python scripts/auth_setup.py
GOOGLE_CLIENT_SECRET_FILE=credentials/client_secret.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# ── Google Calendar (OAuth Google) ──────────────────────────────────
# Active aussi l'API Google Calendar dans le même projet Cloud.
# Puis : python scripts/auth_setup.py calendar
CALENDAR_TOKEN_FILE=credentials/calendar_token.json
# Fuseau horaire de l'utilisateur (ex: Europe/Moscow, Europe/Paris, Africa/Abidjan)
CALENDAR_TIMEZONE=Europe/Moscow

# ── iCloud Mail (IMAP) ──────────────────────────────────────────────
# Ton adresse @icloud.com / @me.com et un mot de passe d'application
# créé sur appleid.apple.com (Sécurité → Mot de passe d'application)
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# ── Spotify ─────────────────────────────────────────────────────────
# Client ID/Secret depuis developer.spotify.com/dashboard.
# Ajoute http://127.0.0.1:8888/callback dans les Redirect URIs du dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_TOKEN_FILE=credentials/spotify_token.json

# ── Contacts locaux ─────────────────────────────────────────────────
CONTACTS_FILE=data/contacts.json

# ── Perplexity (recherche web) ──────────────────────────────────────
# Clé API depuis console.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# Modèle : sonar (rapide), sonar-pro (recommandé), sonar-reasoning-pro, sonar-deep-research
PERPLEXITY_MODEL=sonar-pro

# ── Météo (aucune clé requise — wttr.in) ────────────────────────────
# Ville par défaut des prévisions (nom en anglais recommandé)
WEATHER_LOCATION=Moscow
